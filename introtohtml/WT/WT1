<!DOCTYPE html>
<html>
<head>
    <title>GATE Registration Form</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<h2>GATE Examination Registration</h2>

<form onsubmit="return validateForm()">

    Name: <input type="text" id="name"><br><br>

    Email: <input type="text" id="email"><br><br>

    Password: <input type="password" id="password"><br><br>

    Date of Birth: <input type="date" id="dob"><br><br>

    Mobile Number: <input type="text" id="mobile"><br><br>

    Gender: 
    <input type="radio" name="gender" value="male"> Male
    <input type="radio" name="gender" value="female"> Female
    <br><br>

    Branch:
    <select id="branch">
        <option value="">Select Branch</option>
        <option>Computer Engineering</option>
        <option>Mechanical Engineering</option>
        <option>Civil Engineering</option>
        <option>Electrical Engineering</option>
    </select>
    <br><br>

    Subjects:
    <input type="checkbox" name="subject"> DSA
    <input type="checkbox" name="subject"> DBMS
    <input type="checkbox" name="subject"> OS
    <br><br>

    <input type="submit" value="Submit">
    <input type="reset" value="Reset">

</form>

<script>
function validateForm() {

    let name = document.getElementById("name").value;
    let email = document.getElementById("email").value;
    let password = document.getElementById("password").value;
    let mobile = document.getElementById("mobile").value;
    let branch = document.getElementById("branch").value;

   
    if (name === "") {
        alert("Name is required");
        return false;
    }

   
    let emailPattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;
    if (!email.match(emailPattern)) {
        alert("Enter valid email");
        return false;
    }

    
    if (password.length < 6) {
        alert("Password must be at least 6 characters");
        return false;
    }

    let mobilePattern = /^[0-9]{10}$/;
    if (!mobile.match(mobilePattern)) {
        alert("Enter valid 10-digit mobile number");
        return false;
    }

    
    let gender = document.getElementsByName("gender");
    let selected = false;
    for (let i = 0; i < gender.length; i++) {
        if (gender[i].checked) {
            selected = true;
            break;
        }
    }
    if (!selected) {
        alert("Select gender");
        return false;
    }

    
    if (branch === "") {
        alert("Select branch");
        return false;
    }

    
    let subjects = document.getElementsByName("subject");
    let checked = false;
    for (let i = 0; i < subjects.length; i++) {
        if (subjects[i].checked) {
            checked = true;
            break;
        }
    }
    if (!checked) {
        alert("Select at least one subject");
        return false;
    }

    alert("Form submitted successfully!");
    return true;
}
</script>

</body>
</html>